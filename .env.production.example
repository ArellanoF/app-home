APP_NAME=Vestapp
APP_ENV=production
APP_KEY=base64:GENERATE_A_REAL_KEY
APP_DEBUG=false
APP_URL=https://YOUR_COOLIFY_DOMAIN.sslip.io
APP_TIMEZONE=Europe/Madrid
LOG_LEVEL=warning

DB_DATABASE=vestapp
DB_USERNAME=vestapp
DB_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
DB_ROOT_PASSWORD=GENERATE_ANOTHER_LONG_RANDOM_PASSWORD
DB_FORWARD_PORT=3307

HOUSE_NAME=Zunzuncasa
ADMIN_NAME=Administrador
ADMIN_EMAIL=francescarellano@gmail.com
ADMIN_PASSWORD=
WEATHER_LOCATION=Premià de Dalt

GOOGLE_CALENDAR_PUBLIC_URL=
GOOGLE_CALENDAR_ICAL_URL=

# Generar con: php artisan webpush:generate-vapid-keys
WEB_PUSH_SUBJECT=mailto:administrador@example.com
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Vestapp

# Comprueba la URL publica cada 5 minutos. Avisa tras dos fallos y al recuperarse.
AVAILABILITY_MONITOR_ENABLED=true
AVAILABILITY_MONITOR_URL=${APP_URL}
AVAILABILITY_MONITOR_EMAIL=${ADMIN_EMAIL}
AVAILABILITY_MONITOR_FAILURE_THRESHOLD=2
AVAILABILITY_MONITOR_TIMEOUT=10

WEB_PUSH_SUBJECT=mailto:francescarellano@gmail.com
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
