FROM node:22-alpine AS frontend

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY resources ./resources
COPY public ./public
COPY vite.config.js ./
RUN NPM_CONFIG_IGNORE_SCRIPTS=false npm run build

FROM composer:2 AS vendor

WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --no-scripts --no-progress

FROM php:8.4-fpm-bookworm AS production

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl nginx libzip-dev \
    && docker-php-ext-install bcmath pdo_mysql zip opcache \
    && rm -rf /var/lib/apt/lists/* /var/www/html/* /etc/nginx/sites-enabled/default

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /var/www/html
COPY . .
COPY --from=vendor /app/vendor ./vendor
COPY --from=frontend /app/public/build ./public/build
COPY docker/production/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/production/php.ini /usr/local/etc/php/conf.d/production.ini

RUN composer dump-autoload --no-dev --optimize --no-interaction \
    && mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod +x docker/production/entrypoint.sh docker/production/start-web.sh

EXPOSE 8000

ENTRYPOINT ["docker/production/entrypoint.sh"]
CMD ["docker/production/start-web.sh"]
